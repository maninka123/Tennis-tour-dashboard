# Environment Variables for Tennis Dashboard

# Server Configuration
HOST=0.0.0.0
PORT=5001
DEBUG=True

# API Keys (optional - for premium data sources)
# RAPID_API_KEY=your_api_key_here

# Tennis API Configuration
# TENNIS_API_URL=https://api.example.com
# TENNIS_API_KEY=your_key_here

# Optional live-score fallback (Live Tennis API) — leave unset to disable.
# When set, a tour whose own scraper fails falls back to this API instead of
# the stale on-disk snapshot. The ATP/WTA scrapers stay the primary source.
# LIVETENNISAPI_KEY=your_key_here
# LIVETENNISAPI_BASE_URL=https://api.livetennisapi.com/api/public/v1
